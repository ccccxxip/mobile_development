<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_main"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_enter_range"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editTextBegin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_begin"
        android:text="0"
        android:inputType="numberSigned"
        android:textSize="20sp"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editTextEnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_end"
        android:text="100"
        android:inputType="numberSigned"
        android:textSize="20sp"
        android:importantForAutofill="no"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonGuess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_start"
        android:textSize="20sp"
        android:onClick="onGuessClick" />

</LinearLayout>
